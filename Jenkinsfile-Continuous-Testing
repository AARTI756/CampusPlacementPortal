pipeline {
    agent any

    tools {
        maven 'Maven-3.9.16'
    }

    environment {
        TEST_PORT = '8080'
        JAR_NAME  = 'placement-portal-0.0.1-SNAPSHOT.jar'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== STAGE: Checkout ==='
                checkout scmGit(
                    branches: [[name: '*/feature/continuous-testing']],
                    userRemoteConfigs: [[url: 'https://github.com/AARTI756/CampusPlacementPortal.git']]
                )
            }
        }

        stage('Maven Unit Tests') {
            steps {
                echo '=== STAGE: Unit Tests ==='
                bat 'mvn clean test -Dtest="PlacementPortalApplicationTests"'
            }
        }

        stage('Build & Package') {
            steps {
                echo '=== STAGE: Package ==='
                bat 'mvn package -DskipTests'
            }
        }

        stage('Start Application') {
            steps {
                echo '=== STAGE: Start App for Selenium ==='
                // Ensure port 8080 is clear
                bat 'powershell -NonInteractive -Command "$conn = Get-NetTCPConnection -LocalPort 8080 -ErrorAction SilentlyContinue; if ($conn) { $conn.OwningProcess | Sort-Object -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } }; Start-Sleep -Seconds 3"'
                
                // Start application
                bat 'powershell -NonInteractive -Command "Start-Process java -ArgumentList @(\'-jar\',\'target\\%JAR_NAME%\',\'--server.port=%TEST_PORT%\') -NoNewWindow -RedirectStandardOutput \'app-selenium.log\' -RedirectStandardError \'app-selenium-error.log\'"'
                
                // Wait for the app to come up
                bat '''powershell -NonInteractive -Command "$tries=0; do { Start-Sleep -Seconds 5; $tries++; try { $r = Invoke-WebRequest -Uri http://localhost:%TEST_PORT%/ -UseBasicParsing -ErrorAction Stop; Write-Host 'UP'; break } catch { Write-Host 'Wait...' } } while ($tries -lt 24); if ($tries -ge 24) { Write-Host 'App failed to start'; exit 1 }"'''
            }
        }

        stage('Selenium UI Tests') {
            steps {
                echo '=== STAGE: Selenium Tests ==='
                bat 'mvn test -Dtest="*SeleniumTest" "-DbaseUrl=http://localhost:%TEST_PORT%"'
            }
        }
    }

    post {
        always {
            echo '=== CLEANUP: Stop Application ==='
            bat 'powershell -NonInteractive -Command "$conn = Get-NetTCPConnection -LocalPort 8080 -ErrorAction SilentlyContinue; if ($conn) { $conn.OwningProcess | Sort-Object -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue } }"'
            
            echo '=== PUBLISH TEST RESULTS ==='
            junit 'target/surefire-reports/*.xml'
        }
        success {
            echo 'PIPELINE SUCCESS - All tests passed.'
        }
        failure {
            echo 'PIPELINE FAILED - Tests failed.'
        }
    }
}
